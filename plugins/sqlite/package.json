{
  "name": "@bunova/sqlite",
  "version": "0.1.0-alpha.0",
  "description": "Bunova plugin — SQLite monitoring & lifecycle wrapper for @nds-stack/bunql",
  "author": "nds-stack <nds.stack@gmail.com>",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/index.ts --outdir=./dist --target=bun --format=esm"
  },
  "dependencies": {
    "@nds-stack/bunql": "^0.1.0-alpha.7",
    "bunova": "^0.2.0-alpha.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "keywords": ["bun", "sqlite", "bunova", "monitoring", "plugin"],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
